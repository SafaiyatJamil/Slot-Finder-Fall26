<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>IFP Introduction Session – Find Your Slot</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f4f1;--bg2:#e9ede8;--card:#fff;--ink:#0f1f17;--mute:#5b6a61;--line:#dbe1da;--g:#14523a;--g2:#5fe39b;--tint:#e3f3ea;--input:#fff;--shadow:rgba(8,36,26,.4);--err:#b4503e;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141815;--bg2:#0f1411;--card:#1f2622;--ink:#eef2ef;--mute:#9fada5;--line:#303a34;--g:#8fbfa3;--g2:#6e9c82;--tint:#25332b;--input:#1f2622;--shadow:rgba(0,0,0,.5);--err:#e58a78}}
:root[data-theme="dark"]{--bg:#141815;--bg2:#0f1411;--card:#1f2622;--ink:#eef2ef;--mute:#9fada5;--line:#303a34;--g:#8fbfa3;--g2:#6e9c82;--tint:#25332b;--input:#1f2622;--shadow:rgba(0,0,0,.5);--err:#e58a78}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:linear-gradient(180deg,var(--bg) 0%,var(--bg2) 100%) fixed,var(--bg);color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;line-height:1.5;min-height:100vh}
.hero{background:radial-gradient(circle at 90% 0%,rgba(95,227,155,.28),transparent 50%),linear-gradient(160deg,#071f16 0%,#0e3f2d 55%,#16563d 100%);color:#fff;text-align:center;padding:34px 20px 96px;border-radius:0 0 36px 36px}
.hero-in{max-width:520px;margin:0 auto}
.logo{display:block;width:min(240px,66vw);height:auto;margin:0 auto 22px}
.kicker{font-weight:700;font-size:14px;color:#6ff0a8}
h1{font-family:"Barlow Condensed","Arial Narrow",Impact,sans-serif;font-size:52px;line-height:1;letter-spacing:.01em;text-transform:uppercase;font-weight:800;margin:12px 0 10px}
.lead{margin:0;opacity:.85;font-size:16px}
main{max-width:520px;margin:-56px auto 0;padding:0 18px 100px}
.search{background:var(--card);border-radius:20px;padding:14px;box-shadow:0 14px 40px -18px rgba(0,0,0,.35),0 2px 6px rgba(0,0,0,.05)}
.search label{display:block;font-weight:700;font-size:13px;color:var(--mute);margin:2px 4px 8px}
.row{display:flex;gap:8px}
input{flex:1;min-width:0;font:inherit;font-size:19px;font-weight:700;letter-spacing:.08em;padding:14px 16px;border:2px solid var(--line);border-radius:14px;background:var(--input);color:var(--ink)}
input::placeholder{font-weight:500;letter-spacing:.02em;color:var(--mute);opacity:.7}
input:focus{border-color:var(--g);outline:0}
button{font:inherit;font-weight:800;padding:0 22px;border:0;border-radius:14px;background:linear-gradient(135deg,#86f5b8,#4fd98c);color:#0b2f20;cursor:pointer;transition:transform .15s}
button:active{transform:scale(.96)}
button:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
#out{margin-top:20px}
.ticket{background:var(--card);border-radius:24px;overflow:hidden;box-shadow:0 24px 50px -22px var(--shadow),0 2px 6px rgba(0,0,0,.05);animation:pop .45s cubic-bezier(.2,.8,.2,1)}
@keyframes pop{from{opacity:0;transform:translateY(14px) scale(.98)}}
@media (prefers-reduced-motion:reduce){.ticket,.err{animation:none}}
.tk-head{display:flex;justify-content:space-between;gap:10px;background:linear-gradient(135deg,#0b2f20,#14523a);color:#fff;font-weight:700;font-size:13px;padding:13px 20px}.tk-head span:last-child{color:#6ff0a8}
.tk-body{padding:20px 20px 22px}
.tk-body p{margin:0;color:var(--mute);font-size:14px}
.tk-body h2{margin:2px 0 12px;font-size:25px;line-height:1.2;letter-spacing:-.01em}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips span{background:var(--bg);border:1px solid var(--line);border-radius:99px;padding:4px 12px;font-size:13px;font-weight:700}
.perf{position:relative;border-top:2px dashed var(--line)}
.perf::before,.perf::after{content:"";position:absolute;top:-13px;width:24px;height:24px;border-radius:50%;background:var(--bg)}
.perf::before{left:-12px}.perf::after{right:-12px}
.tk-time{padding:22px 20px;background:linear-gradient(135deg,#8af5b9 0%,#5fe39b 50%,#3fcf82 100%);color:#08241a}
.tk-time .day{font-weight:700;font-size:16px;margin-bottom:2px;color:#0b3a28}
.big{font-size:58px;line-height:1.05;font-weight:800;letter-spacing:-.03em;color:#06201a}
.tk-time .where{font-size:14px;color:#0b3a28;margin-top:2px}
ul{list-style:none;margin:0;padding:14px 20px 22px}
li{position:relative;padding-left:30px;margin:9px 0;font-size:14px}
li::before{content:"✓";position:absolute;left:0;top:1px;width:20px;height:20px;border-radius:50%;background:var(--tint);color:var(--g);font-size:12px;font-weight:800;display:grid;place-items:center}
.err{background:var(--card);border:2px solid var(--err);border-radius:20px;padding:18px 20px;animation:pop .35s ease}
.err h2{margin:0 0 4px;font-size:18px;color:var(--err)}
.err p{margin:0;font-size:14px;color:var(--mute)}
.help{margin-top:26px;background:linear-gradient(135deg,#0b2f20,#14523a);border-radius:16px;padding:16px 18px;text-align:center;font-size:14px;color:rgba(255,255,255,.8)}
.help b{display:block;color:#6ff0a8;font-size:15px}
.made{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:5;white-space:nowrap;background:#1d2822;color:#fff;border:1px solid #33433b;border-radius:99px;padding:8px 16px;font-size:12.5px;font-weight:700;box-shadow:0 10px 26px -10px rgba(0,0,0,.4)}
.made i{font-style:normal;color:#ff6b81}
</style>
</head>
<body>
<section class="hero"><div class="hero-in">
<img class="logo" alt="IUBAT Films and Photography logo" src="data:image/webp;base64,">
<div class="kicker">Introduction Session, Fall 26</div>
<h1>Find your session time</h1>
<p class="lead">Enter your student ID to see your slot.</p>
</div></section>
<main>
<div class="search">
<label for="id">Student ID</label>
<div class="row"><input id="id" inputmode="numeric" autocomplete="off" maxlength="8" placeholder="e.g. 26305030"><button id="go" type="button">Check</button></div>
</div>
<div id="out" aria-live="polite"></div>
<div class="help"><b>Need help?</b>Knock us in our Messenger group.</div>
</main>
<div class="made">Made with <i>♥</i> by SAFAIYAT JAMIL</div>
<script>
var R="26305030|Mahidul islam rahat|BSEEE;26203537|Alfaz Uddin|BCSE;25202135|Sazzad Islam Sihab Turjoy|IBS;26206109|Ayesha Alam|BSCE;25208023|Tasnim Jahan Tanusha|BAEcon;23208004|Afia hoque maliha|BAEcon;26209364|Ayesha Anjum Tugni|BSAg;26205012|Shamin Yeasar|BSEEE;26211037|Jakia Jaman Promi|BATHM;26107044|Kamruzzaman Alif|BSME;26103023|Mohtasin Ahmed|BCSE;26313055|Mushfiq Ahamed Rafid|BAEng;25109164|Tanvir Ahmmed|BSAg;26205097|Rafiul Islam Rahul|BSEEE;26106028|Sonali Alam|BSCE;26311001|Junaidul Islam Jishan|BATHM;25309002|Jarin binta shahid|BSAg;25303088|Ishfaque Ahmed Hemel|BCSE;25309055|Lubana Ashraf Chaity|BSAg;26206183|Aminul Islam Akash|BSCE;26303100|Tanvir Ahmed|BCSE;26206187|Maharuf Mustakim (Rafi)|BSCE;26303096|Jeet Kumar Das|BCSE;26306112|MD, FAHIM Al SHAHRIAR|BCSE;25202115|Sadia Akter Tisha|IBS;26307005|Nahidul Islam Mojumdar|BSME;25212053|Arafa Osman Lata|BSN;26306162|Md. Mostakim Billa|BSCE;25303182|Maimuna Islam Hema|BCSE;25309022|Rezwana Tasnia Riya|BSAg;25205020|Ashikuzzaman Imran|BSEEE;25205018|Abdullah Al Jabery Razin|BSEEE;26103013|Mustakim Hasan Elahe|BCSE;26206205|Md Mehmet|BSCE;26103020|Nurjahan Akter Nipa|BCSE;26205082|Orik Islam|BSEEE;25202035|Umme Jannat Shachi Haque|IBS;25202016|Md. Abu Sayeed|IBS;26205066|Hasanul Islam Radit|BSEEE;26212003|CHANCHAL MONDAL|BSN;26303099|Darus Salam Khan|BCSE;25113033|Jannatul Ferdouse Sumaiya|BAEng;26313049|Nusrat Jahan|BAEng;26313011|Sumaiya Khokon Diya|BAEng;26211009|Nahedul Islam Shovon|BATHM;26103015|Tanvir Hasanat Rahat|BCSE;25211004|Fardous Ara Tonne|BATHM;26306076|Ben Yeamin|BSCE;26206039|Md Mostakim Billah|BSCE;26306061|Md Sazzad Rahman|BSCE;26306005|MD.SABBIR HOSEN SAIKAT|BSCE;24203063|Nahid Hasan|BCSE;25202009|Shibber Ahmed|IBS;26109100|Shafakat muntaha shafin|BSAg;26103212|Md Jubayer ibn Shahidullah|BCSE;26203503|Asfia Tanjid|BCSE;25203096|Azifa Nur Sneha|BCSE;26103228|Khadiza Fnu|BCSE;25309074|Saidul Alam|BSAg;26209407|Mohammad Fatin Ahmed Mumit|BSAg;26313001|Jarin Tasnim Esha|BAEng;26203108|Md Syham Mondol|BCSE".split(";");
var DB={};
R.forEach(function(r,i){var p=r.split("|"),d2=i>=31,k=d2?i-31:i,m=18*60+30+k*10,h=Math.floor(m/60),mm=m%60;
DB[p[0]]={no:i+1,name:p[1],dept:p[2],day:d2?"Thursday, 22 October 2026":"Wednesday, 21 October 2026",time:(h>12?h-12:h)+":"+(mm<10?"0":"")+mm+" PM"}});
var out=document.getElementById("out"),inp=document.getElementById("id");
function esc(s){var d=document.createElement("div");d.textContent=s;return d.innerHTML}
function check(){
var v=inp.value.replace(/\s/g,""),a=DB[v];
if(!v){out.innerHTML='<div class="err"><h2>Enter your ID</h2><p>Type your 8-digit student ID, then press Check.</p></div>';return}
if(!a){out.innerHTML='<div class="err"><h2>ID not found</h2><p>We could not find “'+esc(v)+'” in the list. Check your ID and try again. Still not found? Contact the IFP team.</p></div>';return}
out.innerHTML='<div class="ticket"><div class="tk-head"><span>Fall 26 Introduction Session</span><span>Applicant '+a.no+'</span></div>'+
'<div class="tk-body"><p>Hello,</p><h2>'+esc(a.name)+'</h2><div class="chips"><span>ID '+v+'</span><span>'+esc(a.dept)+'</span></div></div>'+
'<div class="perf"></div><div class="tk-time"><div class="day">'+a.day+'</div><div class="big">'+a.time+'</div><div class="where">on Google Meet</div></div>'+
'<ul><li>Be ready 10–20 minutes before your time.</li><li>Join the Meet link only when your name is announced in the group.</li><li>Keep your camera on. Sit in a quiet, well-lit place.</li><li>Attendance is mandatory.</li></ul></div>'}
document.getElementById("go").addEventListener("click",check);
inp.addEventListener("keydown",function(e){if(e.key==="Enter")check()});
</script>
</body>
</html>
